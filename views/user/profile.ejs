<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SPORTMATCH — 생활 스포츠 매칭 플랫폼</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500;700&family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
<%- include('../partials/navbar') %>
<div class="main">
<%- include('../partials/head', { title: '👤 마이페이지', pageId: 'page-mypage', active: '', route: '/user/profile' }) %>

  <div class="page-body">
    <div class="mypage-layout">
      <!-- Profile Card -->
      <div style="display:flex;flex-direction:column;gap:12px">
        <div class="profile-card">
          <div class="profile-banner"></div>
          <div class="profile-av-wrap">
            <img src="<%= user.profileImage ? '/images/user-profile/' + user.profileImage : '/images/user-profile/default-profile-image.jpg'%>" class="profile-big-av" alt="<%= user.name %>">
          </div>
          <div class="profile-info">
            <div class="profile-name"><%= user.name %></div>
            <div class="profile-handle"><%= user.email %></div>
            <div class="profile-location-pill">📍 <%= user.address.state %> <%= user.address.city %></div>

            <div class="profile-chip-row">
              <span class="profile-chip">🎂 <%= user.age %>세</span>
              <span class="profile-chip">👤 <%= user.gender === 'male' ? '남성' : '여성' %></span>
              <span class="profile-chip">👥 정기크루 <%= user.crews.length %>개</span>
              <span class="profile-chip">🤝 친구 <%= user.friends.length %>명</span>
              <span class="profile-chip">📅 <%= new Date(user.createdAt).toLocaleDateString('ko-KR', { year:'numeric', month:'long' }) %> 가입</span>
            </div>
          </div>

          <div class="profile-divider"></div>

          <div class="profile-stat-row">
            <div class="ps-item"><span class="ps-val"><%= regularCrews.length + instantCrews.length %></span><span class="ps-label">총 활동</span></div>
            <div class="ps-item"><span class="ps-val"><%= regularCrews.length %></span><span class="ps-label">정기 모임</span></div>
            <div class="ps-item"><span class="ps-val"><%= instantCrews.length %></span><span class="ps-label">실시간 활동</span></div>
          </div>

          <div class="honor-box">
            <div class="honor-label-row">
              <span class="honor-label">명예 점수</span>
              <span class="honor-value"><%= user.honor %>점</span>
            </div>
            <div class="honor-track">
              <div class="honor-fill" style="width: <%= Math.min(user.honor, 100) %>%"></div>
            </div>
          </div>
        </div>
        <div class="card" style="overflow:hidden">
          <div class="mypage-nav">
            <button id="regular-tab" class="mypage-nav-item active"><span>📅</span> 정기 모임</button>
            <button id="instant-tab" class="mypage-nav-item"><span>⚡</span> 실시간 모임</button>
            <a href="/user/edit-profile" class="mypage-nav-item"><span>⭐</span> 프로필 수정</a>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="mypage-main">
      <% const sportIconMap = { soccer:'⚽', baseball:'⚾', basketball:'🏀', bowling:'🎳', tennis:'🎾', badminton:'🏸', tabletennis:'🏓' } %>
      <% const sportNameMap = { soccer:'축구', baseball:'야구', basketball:'농구', bowling:'볼링', tennis:'테니스', badminton:'배드민턴', tabletennis:'탁구' } %>
      <div id="regular-section">
        <div class="mypage-card" style="margin-bottom: 16px;">
          <div class="mypage-card-header">
            <div class="mypage-card-title">📅 정기 모임 요일</div>
          </div>
          <div id="regular-calendar" class="regular-calendar"></div>
        </div>
      <div id="regular-card" class="mypage-card">
        <div class="mypage-card-header">
          <div class="mypage-card-title">📅 정기 모임 목록 </div>
                  <div class="filter-row" id="regular-filter">
          <div class="filter-tabs">
            <button type="button" class="filter-tab active" data-role="all">전체</button>
            <button type="button" class="filter-tab" data-role="host">내가 생성</button>
            <button type="button" class="filter-tab" data-role="member">참여 중</button>
          </div>
          <select class="filter-select filter-sport">
            <option value="all">전체 종목</option>
            <% Object.keys(sportNameMap).forEach(key => { %>
              <option value="<%= key %>"><%= sportNameMap[key] %></option>
            <% }) %>
          </select>
          <select class="filter-select filter-day">
            <option value="all">전체 요일</option>
            <option value="mon">월</option><option value="tue">화</option><option value="wed">수</option>
            <option value="thu">목</option><option value="fri">금</option><option value="sat">토</option>
            <option value="sun">일</option>
          </select>
        </div>
        </div>
        <div class="mypage-card-body">
          <% if(regularCrews.length === 0 || !regularCrews) { %>
              <div class="no-data-container">
                <div class="no-data-item">🔍</div>
                <p class="no-data-item" style="font-weight: 700;">가입한 정기 모임이 없어요</p>
                <p class="no-data-item">나와 맞는 정기 모임을 찾아보세요!</p>
                <a href="/regular/my" class="no-data-button">정기 모임 찾아보기</a>
              </div>
          <% } else { %>
          <% regularCrews.forEach((crew, index) => { %>
              <div class="crew-list-item" data-role="<%= crew.crewRole %>" data-sport="<%= crew.sport %>" data-day="<%= crew.day.join(' ') %>" data-crew-id="<%= crew._id %>">
                <img class="crew-thumb"
                    src="<%= crew.profileImage || '/images/reg-crew/profile/default-profile-image.jpg' %>"
                    alt="<%= crew.title %>">

                <div class="crew-info">
                  <div class="crew-title-row">
                    <span class="crew-title"><%= crew.title %></span>
                    <% if(crew.crewRole === 'host') { %><span class="crew-host-badge">👑 나</span><% } %>
                  </div>
                  <p class="crew-intro"><%= crew.intro && crew.intro.trim() ? crew.intro : `${crew.title} 크루입니다. 가입해보세요.` %></p>
                  <div class="crew-meta">
                    <span>📌 <%= crew.address.state %> <%= crew.address.city %></span>
                    <span class="dot">·</span>
                    <span>👤 <%= crew.memberCount %></span>
                    <span class="dot">·</span>
                    <span><%= sportNameMap[crew.sport] || crew.sport %></span>
                  </div>
                  <div class="crew-tags">
                    <span class="crew-tag"><%= crew.ageRangeText %></span>
                    <span class="crew-tag"><%= crew.levelText %></span>
                  </div>
                </div>
              </div>
          <% });%>
          <% }%>
        </div>
        <div class="pagination-row" id="regular-pagination"></div>
      </div>
      </div>

        <div id="instant-section" style="display: none">
        <div class="mypage-card" style="margin-bottom: 16px;">
            <div class="mypage-card-header">
                <div class="mypage-card-title">⚡ 실시간 활동 달력</div>
            </div>
            <div class="calendar-month-header">
                <button id="prev-month-btn" class="calendar-arrow">◀</button>
                <span id="year-month"></span>
                <button id="next-month-btn" class="calendar-arrow">▶</button>
            </div>
            <div id="instant-calendar" class="monthly-calendar"></div>
        </div>

        <div id="instant-card" class="mypage-card">
          <div class="mypage-card-header">
            <div class="mypage-card-title">⚡ 실시간 활동 목록</div>
            <% const now = new Date() %>
            <% const upcomingInstantCrews = instantCrews.filter(crew => new Date(crew.meetAt) >= now) %>
                      <div class="filter-row" id="instant-filter">
            <div class="filter-tabs">
              <button type="button" class="filter-tab active" data-role="all">전체</button>
              <button type="button" class="filter-tab" data-role="host">내가 생성</button>
              <button type="button" class="filter-tab" data-role="member">참여 중</button>
            </div>
            <select class="filter-select filter-sport">
              <option value="all">전체 종목</option>
              <% Object.keys(sportNameMap).forEach(key => { %>
                <option value="<%= key %>"><%= sportNameMap[key] %></option>
              <% }) %>
            </select>
          </div>
          </div>

          <div class="mypage-card-body">
            <% if(upcomingInstantCrews.length === 0 || !upcomingInstantCrews) { %>
                <div class="no-data-container">
                  <div class="no-data-item">🔍</div>
                  <p class="no-data-item" style="font-weight: 700;">아직 가입한 실시간 모임이 없어요</p>
                  <p class="no-data-item">나와 취향이 맞는 실시간 모임을 지도에서 찾아보세요!</p>
                  <a href="/instant/list" class="no-data-button">모임 둘러보기</a>
                </div>
            <% } else { %>
            <% upcomingInstantCrews.forEach((crew, index) => { %>
              <% const meetTime = new Date(crew.meetAt) %>
              <div class="crew-list-item" data-role="<%= crew.crewRole %>" data-sport="<%= crew.sport %>" data-crew-id="<%= crew._id %>">
                <div class="crew-thumb crew-thumb-icon"><%= sportIconMap[crew.sport] || '🏃' %></div>
                <div class="crew-info">
                  <div class="crew-title-row">
                    <span class="crew-title"><%= crew.title %></span>
                    <% if(crew.crewRole === 'host') { %><span class="crew-host-badge">👑 나</span><% } %>
                  </div>
                  <p class="crew-intro"><%= crew.intro && crew.intro.trim() ? crew.intro : `${crew.title} 모임입니다. 참여해보세요.` %></p>
                  <div class="crew-meta">
                    <span>📌 <%= crew.address.state %> <%= crew.address.city %></span>
                    <span class="dot">·</span>
                    <span>👤 <%= crew.memberCount %>/<%= crew.member.capacity %></span>
                    <span class="dot">·</span>
                    <span><%= sportNameMap[crew.sport] || crew.sport %></span>
                  </div>
                </div>
                <div class="sched-manage">
                  <span class="sched-days">
                    <%= meetTime.toDateString() === now.toDateString() ? '오늘' : meetTime.toLocaleDateString('ko-KR', { month:'short', day:'numeric' }) %>
                  </span>
                  <span class="sched-count"><%= meetTime.toLocaleTimeString('ko-KR', { hour:'2-digit', minute:'2-digit' }) %></span>
                </div>
              </div>
            <% });%>
            <% } %>
          </div>
          <div class="pagination-row" id="instant-pagination"></div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="calendar-modal" class="calendar-modal">
    <div class="calendar-modal-content">
        <div class="calendar-modal-header">
            <span id="modal-title"></span>
            <button id="modal-close-btn">✕</button>
        </div>
        <div id="modal-body"></div>
    </div>
</div>

<script id="profile-data" type="application/json">
{
    "regularCrews": <%- JSON.stringify(regularCrews) %>,
    "instantCrews": <%- JSON.stringify(instantCrews) %>
}
</script>
<script src="/js/handlers/profile.js"></script>
</body>
</html>