<div class="manage-group" style="margin-bottom:8px;">
  <div class="manage-header" style="border-bottom:none;">
    <img
      src="<%= crew.profileImage %>"
      class="manage-sport-icon-emoji"
      alt="<%= crew.title %>"
    >

    <div class="manage-header-info">
      <div class="manage-title">
        <%= crew.title %>
      </div>

      <div class="manage-sub">
        <%= crew.address.state %>
        ·
        <%= crew.address.city %>
      </div>
    </div>

    <% if (isOwner || (typeof isMember !== 'undefined' && isMember)) { %>
      <div class="crew-detail-actions">
        <a
          href="/regular/<%= crew._id %>/attendance"
          class="btn btn-outline btn-sm"
          id="crew-attendance-btn"
        >
          출석부
        </a>

      </div>
    <% } %>

    <% if (userId) { %>
      <button
        type="button"
        class="detail-like-btn"
        id="like-btn"
        data-id="<%= crew._id %>"
        onclick="toggleLike('<%= userId %>')"
      >
        <span class="like-icon">🤍</span>
        <span class="like-count" id="like-count">
          <%= crew.reputation %>
        </span>
      </button>
    <% } else { %>
      <button
        type="button"
        class="detail-like-btn"
        id="like-btn"
        data-id="<%= crew._id %>"
        onclick="
          alert('로그인 먼저 하세요');
          return false;
        "
      >
        <span class="like-icon">🤍</span>
        <span class="like-count" id="like-count">
          <%= crew.reputation %>
        </span>
      </button>
    <% } %>
  </div>
</div>

<div class="manage-section">
  <div class="manage-section-header">
    <div class="manage-section-title">
      🖼️ 프로필
    </div>
  </div>

  <div
    class="manage-section-body"
    style="padding:12px 20px;"
  >
    <div class="img-upload-area crew-read-view">
      <div class="avatar-section" style="border:none;">
        <div class="avatar-preview-wrap">
          <div class="avatar-preview">
            <img
              src="<%= crew.profileImage %>"
              alt="<%= crew.title %>"
            >
          </div>
        </div>
      </div>

      <div class="img-upload-info">
        <div class="img-upload-title">
          <%= crew.title %>
        </div>

        <div class="img-upload-sub">
          <%= crew.address.state %>
          ·
          <%= crew.address.city %>
        </div>
      </div>
    </div>
    <% if (isOwner) { %><div data-crew-edit-slot="profile"></div><% } %>
  </div>
</div>

<div class="manage-section">
  <div class="manage-section-header">
    <div class="manage-section-title">
      크루 소개
    </div>
  </div>

  <div class="manage-section-body">
    <div class="detail-intro crew-read-view">
      <% if (crew.introBlocks && crew.introBlocks.length) { %>
        <% crew.introBlocks.forEach(block => { %>
          <% if (block.type === 'text') { %>
            <p class="crew-intro-text"><%= block.text %></p>
          <% } else if (block.type === 'image' && /^\/images\/reg-crew\/intro\/[a-f0-9-]+\.(jpg|png|webp)$/.test(block.src || '')) { %>
            <img class="crew-intro-image" src="<%= block.src %>" alt="크루 소개 사진" loading="lazy">
          <% } %>
        <% }) %>
      <% } else { %>
        <%= crew.intro || '등록된 소개가 없습니다.' %>
      <% } %>
    </div>
    <% if (isOwner) { %><div data-crew-edit-slot="intro"></div><% } %>
  </div>
</div>

<div class="manage-section">
  <div class="manage-section-header">
    <div class="manage-section-title">
      안내사항
    </div>
  </div>

  <div class="manage-section-body">
    <div class="manage-cond-list crew-read-view">
      <div class="manage-cond-item">
        <span class="manage-cond-icon">🏃</span>
        <span class="manage-cond-label">경기 종목</span>
        <span class="manage-cond-value">
          <%= crew.sportLabel %>
        </span>
      </div>

      <div class="manage-cond-item">
        <span class="manage-cond-icon">⭐</span>
        <span class="manage-cond-label">실력 수준</span>
        <span class="manage-cond-value">
          <%= crew.levelLabel %>
        </span>
      </div>

      <div class="manage-cond-item">
        <span class="manage-cond-icon">💰</span>
        <span class="manage-cond-label">참가비</span>
        <span class="manage-cond-value">
          <%= crew.fee > 0
            ? crew.fee.toLocaleString() + '원/회'
            : '무료'
          %>
        </span>
      </div>

      <div class="manage-cond-item">
        <span class="manage-cond-icon">📍</span>
        <span class="manage-cond-label">주 모임 장소</span>
        <span class="manage-cond-value">
          <%= crew.address.detail || '-' %>
        </span>
      </div>

      <div class="manage-cond-item">
        <span class="manage-cond-icon">📅</span>
        <span class="manage-cond-label">활동 요일</span>
        <span class="manage-cond-value">
          <%= crew.dayLabel %>
        </span>
      </div>

      <div class="manage-cond-item">
        <span class="manage-cond-icon">👥</span>
        <span class="manage-cond-label">연령대</span>
        <span class="manage-cond-value">
          <%= crew.ageLabel %>
        </span>
      </div>
    </div>
    <% if (isOwner) { %><div data-crew-edit-slot="conditions"></div><% } %>
  </div>
</div>
