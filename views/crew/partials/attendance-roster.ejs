<% const attendanceStates = [
    { key: 'present', label: '출석' },
    { key: 'late', label: '지각' },
    { key: 'absent', label: '결석' },
    { key: 'pending', label: '미출석' }
]; %>
<div class="attendance-summary">
    <strong>참가자 <%= members.length %>명</strong>
    <% attendanceStates.forEach(state => { %>
        <span><%= state.label %> <%= members.filter(m => (m.status || (m.attended ? 'present' : 'pending')) === state.key).length %>명</span>
    <% }); %>
</div>
<div class="attendance-rosters">
    <% attendanceStates.forEach(state => { const group = members.filter(member => (member.status || (member.attended ? 'present' : 'pending')) === state.key); %>
        <section class="attendance-card">
            <div class="attendance-roster-heading">
                <h3><%= state.label %> 멤버</h3>
                <span class="attendance-count"><%= group.length %></span>
            </div>
            <ul class="attendance-member-list">
                <% group.forEach(member => { %>
                    <li>
                        <span class="attendance-avatar" aria-hidden="true"><%= Array.from(member.name)[0] %></span>
                        <strong><%= member.name %></strong>
                        <span class="attendance-member-state <%= state.key === 'present' ? 'attended' : state.key %>"><%= state.label %></span>
                    </li>
                <% }); %>
            </ul>
            <% if (!group.length) { %>
                <p class="attendance-empty-list"><%= state.label %> 멤버가 없어요.</p>
            <% } %>
        </section>
    <% }); %>
</div>
