<div class="detail-footer">
  <% if (isOwner) { %>
    <button
      type="button"
      class="join-btn"
      id="footer-edit-btn"
    >
      크루 정보 수정하기
    </button>

  <% } else if (isMember) { %>
    <button
      type="button"
      class="join-btn"
      disabled
      data-button-state="success"
    >
      ✓ 가입 완료
    </button>

  <% } else { %>
    <button
      type="button"
      class="join-btn"
      id="join-btn"
      style="display:none;"
    ></button>
  <% } %>
</div>