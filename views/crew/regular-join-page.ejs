<!-- 정기모임 상세: 가입 회원은 스케줄과 멤버 탭을 함께 사용합니다. -->
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>SPORTMATCH — 모임 상세</title>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500;700&family=Bebas+Neue&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/regular-detail.css">
</head>

<body>
  <%- include('../partials/navbar') %>

  <%
    const currentUserId = userId
      ? userId.toString()
      : '';

    const hostId = crew.host && crew.host._id
      ? crew.host._id.toString()
      : crew.host?.toString();

    const isOwner = Boolean(
      currentUserId &&
      currentUserId === hostId
    );

    const isMember = Boolean(
      currentUserId &&
      !isOwner &&
      crew.member.memberList.some(member => {
        const memberId = member.user && member.user._id
          ? member.user._id.toString()
          : member.user?.toString();

        return memberId === currentUserId;
      })
    );

    const hasReviewed = Boolean(
      currentUserId &&
      reviews.some(review => {
        const authorId =
          review.author && review.author._id
            ? review.author._id.toString()
            : review.author?.toString();

        return authorId === currentUserId;
      })
    );
  %>

  <div class="main">
    <%- include('../partials/head', {
      title: `📋 ${crew.title}`,
      pageId: 'page-crew-detail',
      active: '',
      route: `/regular/list/${crew._id}`
    }) %>

    <div class="page-body">
      <div
        class="detail-wrap"
        style="max-width:720px;margin:0 auto;"
      >
        <div class="crew-detail-navigation">
          <a href="/regular/list" class="goback-btn">← 목록으로</a>
          <% if (isOwner) { %>
            <form method="POST" action="/regular/delete/<%= crew._id %>" data-crew-confirm="모임을 해산하시겠습니까? 해산한 모임은 복구할 수 없습니다.">
              <button type="submit" class="btn crew-disband-btn">모임 해산</button>
            </form>
          <% } %>
        </div>

        <% if (isOwner || isMember) { %>
          <div class="manage-tab-bar" role="tablist" aria-label="모임 상세 메뉴">
            <button type="button" class="manage-tab active" id="tab-info" role="tab" aria-selected="true" aria-controls="panel-info" data-crew-tab="info">📋 모임 상세</button>
            <button type="button" class="manage-tab" id="tab-schedule" role="tab" aria-selected="false" aria-controls="panel-schedule" tabindex="-1" data-crew-tab="schedule">📅 스케줄</button>
            <button type="button" class="manage-tab" id="tab-members" role="tab" aria-selected="false" aria-controls="panel-members" tabindex="-1" data-crew-tab="members">👥 멤버</button>
          </div>
        <% } %>

        <div class="manage-panel active" id="panel-info" <%- isOwner || isMember ? 'role="tabpanel" aria-labelledby="tab-info"' : '' %>>
        <!-- 공통 크루 정보 -->
        <%- include('./partials/crew-info', {
          crew,
          userId,
          isOwner,
          isMember
        }) %>

        <!-- 크루장 정보 수정 -->
        <% if (isOwner) { %>
          <%- include('./partials/crew-edit', {
            crew
          }) %>
        <% } %>

        <!-- 후기 목록 및 작성 -->
        <%- include('./partials/crew-reviews', {
          crew,
          reviews,
          isMember,
          hasReviewed
        }) %>

        <!-- 가입 신청 및 가입 상태 -->
        <%- include('./partials/crew-join-status', {
          crew,
          userId,
          isOwner,
          isMember
        }) %>
        <% if (isMember) { %>
          <form method="POST" action="/regular/withdraw/<%= crew._id %>" data-crew-confirm="모임에서 탈퇴하시겠습니까?" style="margin-top:16px;">
            <button type="submit" class="action-btn danger">모임 탈퇴</button>
          </form>
        <% } %>
        </div>

        <% if (isOwner || isMember) { %>
          <%- include('./partials/crew-schedule', { acts, currentUserId }) %>
          <%- include('./partials/crew-members', { crew, pendingApps, isOwner, hostId }) %>
          <script type="module" src="/js/regularCrew/detail-tabs.js"></script>
        <% } %>
      </div>
    </div>
  </div>

<script src="/js/like.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const userId = '<%= userId || "" %>';
  const crewId = '<%= crew._id %>';
  const joinBtn = document.getElementById('join-btn');

  // 크루장이나 멤버에게는 가입 버튼이 없음
  if (!joinBtn) return;

  if (!userId) {
    joinBtn.textContent = '가입 신청하기';
    joinBtn.style.display = 'block';

    joinBtn.onclick = () => {
      alert('로그인 후 이용할 수 있습니다.');
      location.href = '/user/login';
    };

    return;
  }

  const labels = {
    none: '가입 신청하기',
    pending: '가입 승인 대기 중입니다',
    member: '이미 가입된 크루입니다',
    accepted: '3일에 한 번만 신청할 수 있습니다',
    rejected: '3일에 한 번만 신청할 수 있습니다'
  };

  function showRelation(relation) {
    joinBtn.style.display = 'block';
    joinBtn.textContent = labels[relation] || '가입 상태를 확인할 수 없습니다. 새로고침해주세요.';
    joinBtn.disabled = relation !== 'none';
  }

  async function refreshRelation() {
    try {
      const response = await fetch(`/regular/relation/${crewId}/${userId}`);
      if (!response.ok) throw new Error('관계 확인 실패');
      showRelation((await response.json()).relation);
    } catch (error) {
      console.error('관계 확인 오류:', error);
      showRelation();
    }
  }

  joinBtn.onclick = async () => {
    if (joinBtn.disabled || !confirm('가입 신청을 하시겠습니까?')) return;
    joinBtn.disabled = true;
    joinBtn.textContent = '가입 신청 중…';
    try {
      const response = await fetch(`/regular/application/${crewId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await response.json();
      if (response.status !== 409 && !response.ok) {
        throw new Error(data.message || '신청 중 문제가 발생했습니다.');
      }
      if (response.status === 409) {
        await refreshRelation();
        return;
      }
      showRelation(data.relation);
      if (data.relation === 'member') window.location.reload();
    } catch (error) {
      await refreshRelation();
      if (!joinBtn.disabled) alert(error.message || '신청 중 문제가 발생했습니다.');
    }
  };

  await refreshRelation();
});

let liked = <%= isLiked === true ? 'true' : 'false' %>;
let likeCount = <%= crew.reputation %>;
</script>

<script type="module">
  import { initProfileModal, openProfileModal } from '/js/components/profileModal.js';
  <% if (locals.user) { %>
  const socket = io('/noti', { auth: { userId: '<%= user._id %>' } });
  initProfileModal(socket, '<%= user._id %>');
  <% } else { %>
  initProfileModal(null, null);
  <% } %>
  window.openProfileModal = openProfileModal;

document.addEventListener('DOMContentLoaded', () => {
  const openReviewBtn = document.getElementById('open-review-btn');
  const cancelReviewBtn = document.getElementById('cancel-review-btn');
  const reviewForm = document.getElementById('review-form');

  if (!reviewForm) return;

  openReviewBtn.addEventListener('click', () => {
    const hasReviewed =
      openReviewBtn.dataset.hasReviewed === 'true';

    if (hasReviewed) {
      alert('이미 후기를 등록하셨습니다.');
      return;
    }

    reviewForm.style.display = 'block';
    openReviewBtn.style.display = 'none';
  });

  cancelReviewBtn.addEventListener('click', () => {
    reviewForm.reset();
    reviewForm.style.display = 'none';
    openReviewBtn.style.display = 'inline-flex';
  });

  reviewForm.addEventListener('submit', async event => {
    event.preventDefault();

    const rating = Number(
      document.getElementById('review-rating').value
    );

    const content = document
      .getElementById('review-content')
      .value
      .trim();

    if (!rating || !content) {
      alert('평점과 후기 내용을 입력해주세요.');
      return;
    }

    try {
      const response = await fetch(
        '/regular/review/<%= crew._id %>',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            rating,
            content
          })
        }
      );

      const result = await response.json();

      if (!response.ok) {
        alert(result.message || '후기 등록에 실패했습니다.');
        return;
      }

      alert('후기가 등록되었습니다.');
      window.location.reload();
    } catch (error) {
      console.error('후기 등록 오류:', error);
      alert('서버 오류가 발생했습니다.');
    }
  });
});

</script>
</body>
</html>
