<section class="crew-spotlight" aria-label="추천하는 모임" aria-roledescription="캐러셀" tabindex="0">
  <div class="spotlight-heading"><h2>추천하는 모임</h2><a href="/regular/list">전체 모임 보기 ↗</a></div>
  <div class="spotlight-stage">
    <button class="spotlight-arrow spotlight-prev" data-crew-step="-1" aria-label="이전 모임">‹</button>
    <div id="crew-spotlight-card"></div>
    <button class="spotlight-arrow spotlight-next" data-crew-step="1" aria-label="다음 모임">›</button>
    <span id="crew-position" role="status" aria-live="polite"></span>
  </div>
</section>
<script id="crew-spotlight-data" type="application/json"><%- JSON.stringify(regularMeetings).replace(/</g, '\\u003c') %></script>
